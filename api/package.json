    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
